{
    "name": "tubarao-backend",
    "version": "1.0.0",
    "description": "Backend API para Tubarão Empréstimos",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "npx prisma generate && tsc",
        "start": "node dist/server.js",
        "postinstall": "npx prisma generate",
        "db:migrate": "npx prisma migrate dev",
        "db:push": "npx prisma db push",
        "db:studio": "npx prisma studio",
        "db:seed": "tsx src/seed.ts"
    },
    "dependencies": {
        "@prisma/client": "^6.3.0",
        "axios": "^1.8.2",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "cron": "^4.4.0",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "jsonwebtoken": "^9.0.2",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^6.9.16",
        "uuid": "^11.1.0",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/multer": "^1.4.12",
        "@types/nodemailer": "^6.4.17",
        "@types/uuid": "^10.0.0",
        "@types/web-push": "^3.6.4",
        "prisma": "^6.3.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3"
    }
}