// Objetivo: Reestruturação completa do sistema de pós-aprovação
// ============================================================================

// IMPORTANTE: Este arquivo contém APENAS as alterações necessárias
// Você deve MESCLAR estas mudanças com o schema.prisma existente

// ============================================================================
// 1. ATUALIZAÇÃO DO MODELO Customer (CLIENTES ATIVOS)
// ============================================================================

model Customer {
  id                  String         @id @default(uuid())
  userId              String?        @map("user_id")
  name                String
  cpf                 String         @unique
  rg                  String?
  email               String
  phone               String
  status              String         @default("ACTIVE") // ACTIVE, INACTIVE, DEFAULTING, IN_AGREEMENT, BLACKLISTED
  internalScore       Int            @default(0) @map("internal_score")
  totalDebt           Float          @default(0) @map("total_debt")
  activeLoansCount    Int            @default(0) @map("active_loans_count")
  address             String?
  neighborhood        String?
  city                String?
  state               String?
  zipCode             String?        @map("zip_code")
  latitude            Float?
  longitude           Float?
  locationUpdatedAt   DateTime?      @map("location_updated_at")
  deviceInfo          String?        @map("device_info")
  lastIp              String?        @map("last_ip")
  monthlyIncome       Float?         @map("monthly_income")
  preApprovedAmount   Float?         @map("pre_approved_amount")
  preApprovedAt       DateTime?      @map("pre_approved_at")
  instagram           String?
  source              String?        @default("MANUAL")
  profilePic          String?        @map("profile_pic")
  birthDate           String?        @map("birth_date")
  monthlyInterestRate Float?         @map("monthly_interest_rate")
  lateFixedFee        Float?         @map("late_fixed_fee")
  lateInterestDaily   Float?         @map("late_interest_daily")
  lateInterestMonthly Float?         @map("late_interest_monthly")
  installmentOffer    Json?          @map("installment_offer")
  referralCode        String?        @unique @map("referral_code")
  referralPoints      Int            @default(0) @map("referral_points")
  joinedAt            DateTime       @default(now()) @map("joined_at")
  partnerId           String?        @map("partner_id")
  isPartnerCustomer   Boolean        @default(false) @map("is_partner_customer")
  partnerCommissionRate Float?       @map("partner_commission_rate")
  contractTermsAccepted Boolean      @default(false) @map("contract_terms_accepted")

  // ===== NOVOS CAMPOS PARA INADIMPLÊNCIA =====
  isDefaulting        Boolean        @default(false) @map("is_defaulting") // Cliente está inadimplente?
  defaultingSince     DateTime?      @map("defaulting_since") // Data que entrou em inadimplência
  daysOverdue         Int            @default(0) @map("days_overdue") // Dias de atraso total
  totalOverdueAmount  Float          @default(0) @map("total_overdue_amount") // Valor total em atraso
  lastContactDate     DateTime?      @map("last_contact_date") // Última tentativa de contato
  assignedCollectorId String?        @map("assigned_collector_id") // Cobrador responsável
  collectionNotes     String?        @map("collection_notes") // Observações de cobrança

  // ===== RELACIONAMENTOS =====
  coupons             Coupon[]
  user                User?          @relation(fields: [userId], references: [id], name: "CustomerUser")
  partner             User?          @relation(fields: [partnerId], references: [id], name: "CustomerPartner")
  assignedCollector   User?          @relation(fields: [assignedCollectorId], references: [id], name: "CustomerCollector")
  loanRequests        LoanRequest[]  @relation("LoanRequestCustomer")
  loans               Loan[]
  notifications       Notification[]
  referralsGiven      Referral[]     @relation("ReferrerCustomer")
  referralsReceived   Referral[]     @relation("ReferredCustomer")
  collectionHistory   CollectionHistory[]
  agreements          Agreement[]

  @@map("customers")
}

// ============================================================================
// 2. ATUALIZAÇÃO DO MODELO LoanRequest (SOLICITAÇÕES)
// ============================================================================

model LoanRequest {
  id                      String    @id @default(uuid())
  customerId              String?   @map("customer_id")
  userId                  String?   @map("user_id")
  clientName              String    @map("client_name")
  cpf                     String
  email                   String
  phone                   String
  preferredContactTime    String?   @map("preferred_contact_time")

  // ===== VALORES E APROVAÇÃO =====
  amount                  Float     @default(0) // Valor solicitado original
  requestedAmount         Float?    @map("requested_amount") // Backup do valor solicitado
  approvedAmount          Float?    @map("approved_amount") // Valor aprovado pelo admin (CONTRAPROPOSTA)
  approvedAt              DateTime? @map("approved_at")
  approvedById            String?   @map("approved_by_id")
  counterOfferAccepted    Boolean   @default(false) @map("counter_offer_accepted")
  counterOfferAcceptedAt  DateTime? @map("counter_offer_accepted_at")

  // ===== PARÂMETROS DE COBRANÇA (DEFINIDOS NA APROVAÇÃO) =====
  chargeType              String?   @map("charge_type") // DAILY, WEEKLY, MONTHLY, CUSTOM
  chargePeriod            Int?      @map("charge_period") // Quantidade de dias/parcelas
  interestRate            Float?    @map("interest_rate") // Taxa de juros (%)
  totalDebtAmount         Float?    @map("total_debt_amount") // Valor total da dívida (principal + juros)
  installmentAmount       Float?    @map("installment_amount") // Valor de cada parcela
  firstPaymentDate        DateTime? @map("first_payment_date") // Data do primeiro pagamento

  installments            Int       @default(1)
  status                  String    @default("PENDING") // PENDING, APPROVED, REJECTED, ACTIVE, COMPLETED
  profileType             String?   @map("profile_type")

  // ===== CONTATOS DE EMERGÊNCIA =====
  fatherPhone             String?   @map("father_phone")
  motherPhone             String?   @map("mother_phone")
  spousePhone             String?   @map("spouse_phone")
  fatherPhoneRelationship String?   @map("father_phone_relationship")
  motherPhoneRelationship String?   @map("mother_phone_relationship")
  spousePhoneRelationship String?   @map("spouse_phone_relationship")

  // ===== ENDEREÇO =====
  address                 String?
  neighborhood            String?
  city                    String?
  state                   String?
  zipCode                 String?   @map("zip_code")
  birthDate               String?   @map("birth_date")
  preferredDueDay         Int?      @map("preferred_due_day")
  instagram               String?
  monthlyIncome           Float?    @map("monthly_income")

  // ===== DOCUMENTOS =====
  selfieUrl               String?   @map("selfie_url")
  idCardUrl               String?   @map("id_card_url")
  idCardBackUrl           String?   @map("id_card_back_url")
  proofOfAddressUrl       String?   @map("proof_of_address_url")
  proofIncomeUrl          String?   @map("proof_income_url")
  vehicleUrl              String?   @map("vehicle_url")
  videoSelfieUrl          String?   @map("video_selfie_url")
  videoHouseUrl           String?   @map("video_house_url")
  videoVehicleUrl         String?   @map("video_vehicle_url")
  signatureUrl            String?   @map("signature_url")
  workCardUrl             String?   @map("work_card_url")
  supplementalDocUrl      String?   @map("supplemental_doc_url")
  supplementalDescription String?   @map("supplemental_description")
  supplementalRequestedAt DateTime? @map("supplemental_requested_at")
  supplementalUploadedAt  DateTime? @map("supplemental_uploaded_at")

  // ===== DADOS PROFISSIONAIS =====
  companyAddress          Json?     @map("company_address")
  companyProfession       String?   @map("company_profession")
  companyWorkSince        String?   @map("company_work_since")
  companyIncome           Float?    @map("company_income")
  companyPaymentDay       Int?      @map("company_payment_day")
  companyName             String?   @map("company_name")

  // ===== GEOLOCALIZAÇÃO =====
  latitude                Float?
  longitude               Float?
  accuracy                Float?

  // ===== CONTRATOS E TERMOS =====
  contractAccepted        Boolean   @default(false) @map("contract_accepted")
  contractTermsAccepted   Boolean   @default(false) @map("contract_terms_accepted")
  declarationAccepted     Boolean   @default(false) @map("declaration_accepted")
  contractPdfUrl          String?   @map("contract_pdf_url")

  // ===== DADOS BANCÁRIOS =====
  bankName                String?   @map("bank_name")
  bankAgency              String?   @map("bank_agency")
  bankAccount             String?   @map("bank_account")
  bankAccountType         String?   @map("bank_account_type")
  pixKey                  String?   @map("pix_key")
  pixKeyType              String?   @map("pix_key_type")

  // ===== TIMESTAMPS =====
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  // ===== PARCERIA =====
  referralCode            String?   @map("referral_code")
  partnerId               String?   @map("partner_id")
  isPartnerReferral       Boolean   @default(false) @map("is_partner_referral")
  partnerCommissionRate   Float?    @map("partner_commission_rate")

  // ===== INVESTIDOR =====
  investmentTier          String?   @map("investment_tier")
  payoutMode              String?   @map("payout_mode")
  monthlyRate             Float?    @map("monthly_rate")
  contractMonths          Int?      @map("contract_months")
  autoRenew               Boolean   @default(true) @map("auto_renew")
  withdrawalNoticeMonths  Int?      @map("withdrawal_notice_months")
  accountHolderName       String?   @map("account_holder_name")

  // ===== FLAGS DE CLASSIFICAÇÃO =====
  isService               Boolean   @default(false) @map("is_service")
  isInvestment            Boolean   @default(false) @map("is_investment")
  isLoan                  Boolean   @default(true) @map("is_loan")

  // ===== GARANTIAS =====
  collateralItems         Json?     @map("collateral_items")

  // ===== RELACIONAMENTOS =====
  customer                Customer? @relation(fields: [customerId], references: [id], name: "LoanRequestCustomer")
  user                    User?     @relation(fields: [userId], references: [id], name: "LoanRequestUser")
  partner                 User?     @relation(fields: [partnerId], references: [id], name: "LoanRequestPartner")
  approvedBy              User?     @relation(fields: [approvedById], references: [id], name: "LoanRequestApprovedBy")
  loan                    Loan?
  partnerCommissions      PartnerCommission[] @relation("PartnerCommissionLoanRequest")

  @@map("loan_requests")
}

// ============================================================================
// 3. ATUALIZAÇÃO DO MODELO Loan (EMPRÉSTIMOS ATIVOS)
// ============================================================================

model Loan {
  id                      String        @id @default(uuid())
  customerId              String        @map("customer_id")
  requestId               String        @unique @map("request_id")

  // ===== VALORES =====
  amount                  Float // Valor principal aprovado/transferido
  principalAmount         Float @map("principal_amount") // Valor final aprovado
  totalDebtAmount         Float @map("total_debt_amount") // Valor total com juros
  remainingAmount         Float @map("remaining_amount") // Saldo devedor atual
  paidAmount              Float @default(0) @map("paid_amount") // Total já pago

  // ===== PARCELAS/DIÁRIAS =====
  installmentsCount       Int @map("installments_count")
  totalInstallments       Int @map("total_installments")
  paidInstallments        Int @default(0) @map("paid_installments") // Parcelas pagas
  overdueInstallments     Int @default(0) @map("overdue_installments") // Parcelas atrasadas
  dailyInstallmentAmount  Float? @map("daily_installment_amount")

  // ===== TIPO DE COBRANÇA =====
  chargeType              String @map("charge_type") // DAILY, WEEKLY, MONTHLY, CUSTOM
  chargePeriod            Int @map("charge_period") // Quantidade de dias/parcelas
  interestRate            Float @map("interest_rate") // Taxa de juros aplicada
  paymentFrequency        String @default("MONTHLY") @map("payment_frequency")
  dueDay                  Int? @map("due_day")

  // ===== DATAS =====
  startDate               DateTime @map("start_date")
  firstPaymentDate        DateTime @map("first_payment_date")
  lastPaymentDate         DateTime? @map("last_payment_date")
  nextPaymentDate         DateTime? @map("next_payment_date")

  // ===== LIBERAÇÃO DO EMPRÉSTIMO (ETAPA 4) =====
  releasedAmount          Float? @map("released_amount") // Valor efetivamente liberado
  releasedAt              DateTime? @map("released_at") // Data da liberação
  releaseMethod           String? @map("release_method") // PIX, TED, DINHEIRO
  pixReceiptUrl           String? @map("pix_receipt_url") // ⚠️ OBRIGATÓRIO - Comprovante de PIX
  releaseNotes            String? @map("release_notes") // Observações da liberação
  releasedById            String? @map("released_by_id") // Admin que liberou

  // ===== STATUS E INADIMPLÊNCIA =====
  status                  String @default("PENDING_RELEASE") // PENDING_RELEASE, ACTIVE, DEFAULTING, IN_AGREEMENT, COMPLETED, CANCELLED
  daysOverdue             Int @default(0) @map("days_overdue")
  isDefaulting            Boolean @default(false) @map("is_defaulting")
  defaultingSince         DateTime? @map("defaulting_since")

  // ===== FLAGS DE CLASSIFICAÇÃO =====
  nivelOuroUtilizado      Boolean @default(false) @map("nivel_ouro_utilizado")
  dataAtivacaoNivelOuro   DateTime? @map("data_ativacao_nivel_ouro")
  isService               Boolean @default(false) @map("is_service")
  isInvestment            Boolean @default(false) @map("is_investment")
  isLoan                  Boolean @default(true) @map("is_loan")

  // ===== OBSERVAÇÕES =====
  adminNotes              String? @map("admin_notes")

  // ===== TIMESTAMPS =====
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  // ===== RELACIONAMENTOS =====
  installments            Installment[]
  payments                Payment[]
  customer                Customer @relation(fields: [customerId], references: [id])
  loanRequest             LoanRequest @relation(fields: [requestId], references: [id])
  releasedBy              User? @relation(fields: [releasedById], references: [id], name: "LoanReleasedBy")
  agreements              Agreement[]
  collectionHistory       CollectionHistory[]

  @@map("loans")
  @@index([status])
  @@index([customerId])
  @@index([nextPaymentDate])
  @@index([isDefaulting])
}

// ============================================================================
// 4. NOVA TABELA: Payment (REGISTRO DE PAGAMENTOS)
// ============================================================================

model Payment {
  id              String    @id @default(uuid())
  loanId          String    @map("loan_id")
  installmentId   String?   @map("installment_id") // Opcional: vincula a uma parcela específica
  customerId      String    @map("customer_id")

  // ===== VALORES =====
  amount          Float // Valor pago
  principalAmount Float @map("principal_amount") // Quanto foi para o principal
  interestAmount  Float @default(0) @map("interest_amount") // Quanto foi de juros
  feeAmount       Float @default(0) @map("fee_amount") // Quanto foi de multa/taxa

  // ===== DADOS DO PAGAMENTO =====
  paymentDate     DateTime @map("payment_date") // Data que o cliente pagou
  registeredAt    DateTime @default(now()) @map("registered_at") // Data que foi registrado no sistema
  paymentMethod   String @map("payment_method") // PIX, DINHEIRO, TED, BOLETO
  proofUrl        String? @map("proof_url") // Comprovante do pagamento

  // ===== CONTROLE =====
  registeredById  String @map("registered_by_id") // Admin que registrou
  notes           String? // Observações
  status          String @default("CONFIRMED") // PENDING, CONFIRMED, CANCELLED

  // ===== RELACIONAMENTOS =====
  loan            Loan @relation(fields: [loanId], references: [id])
  installment     Installment? @relation(fields: [installmentId], references: [id])
  registeredBy    User @relation(fields: [registeredById], references: [id], name: "PaymentRegisteredBy")

  @@map("payments")
  @@index([loanId])
  @@index([customerId])
  @@index([paymentDate])
}

// ============================================================================
// 5. ATUALIZAÇÃO DO MODELO Installment (PARCELAS)
// ============================================================================

model Installment {
  id              String    @id @default(uuid())
  loanId          String    @map("loan_id")
  installmentNumber Int     @map("installment_number") // Número da parcela (1, 2, 3...)

  // ===== VALORES =====
  amount          Float // Valor da parcela
  principalAmount Float @map("principal_amount") // Quanto é principal
  interestAmount  Float @map("interest_amount") // Quanto é juros
  remainingAmount Float @map("remaining_amount") // Saldo devedor após esta parcela

  // ===== DATAS =====
  dueDate         DateTime @map("due_date")
  paidAt          DateTime? @map("paid_at")

  // ===== STATUS =====
  status          String @default("OPEN") // OPEN, PAID, OVERDUE, PARTIAL
  daysOverdue     Int @default(0) @map("days_overdue")

  // ===== PAGAMENTO =====
  paidAmount      Float @default(0) @map("paid_amount") // Valor já pago (para pagamentos parciais)
  pixCode         String? @map("pix_code")
  proofUrl        String? @map("proof_url")

  // ===== TIMESTAMPS =====
  createdAt       DateTime @default(now()) @map("created_at")

  // ===== RELACIONAMENTOS =====
  loan            Loan @relation(fields: [loanId], references: [id])
  payments        Payment[]

  @@map("installments")
  @@index([loanId])
  @@index([status])
  @@index([dueDate])
}

// ============================================================================
// 6. NOVA TABELA: Agreement (ACORDOS/RENEGOCIAÇÕES)
// ============================================================================

model Agreement {
  id                String    @id @default(uuid())
  loanId            String    @map("loan_id")
  customerId        String    @map("customer_id")

  // ===== VALORES =====
  originalDebt      Float     @map("original_debt") // Dívida original
  agreedAmount      Float     @map("agreed_amount") // Valor acordado
  discount          Float     @default(0) // Desconto concedido
  newInstallments   Int       @map("new_installments") // Novas parcelas
  installmentAmount Float     @map("installment_amount") // Valor de cada parcela

  // ===== DATAS =====
  firstPaymentDate  DateTime  @map("first_payment_date")
  createdAt         DateTime  @default(now()) @map("created_at")

  // ===== STATUS =====
  status            String    @default("ACTIVE") // ACTIVE, COMPLETED, BROKEN

  // ===== CONTROLE =====
  createdById       String    @map("created_by_id") // Admin que criou o acordo
  notes             String?

  // ===== RELACIONAMENTOS =====
  loan              Loan      @relation(fields: [loanId], references: [id])
  customer          Customer  @relation(fields: [customerId], references: [id])
  createdBy         User      @relation(fields: [createdById], references: [id], name: "AgreementCreatedBy")

  @@map("agreements")
  @@index([loanId])
  @@index([customerId])
  @@index([status])
}

// ============================================================================
// 7. NOVA TABELA: CollectionHistory (HISTÓRICO DE COBRANÇA)
// ============================================================================

model CollectionHistory {
  id              String    @id @default(uuid())
  loanId          String    @map("loan_id")
  customerId      String    @map("customer_id")

  // ===== DADOS DA COBRANÇA =====
  contactDate     DateTime  @map("contact_date")
  contactMethod   String    @map("contact_method") // WHATSAPP, CALL, SMS, EMAIL, VISIT
  contactResult   String    @map("contact_result") // ANSWERED, NO_ANSWER, PROMISED_TO_PAY, REFUSED, WRONG_NUMBER
  promisedDate    DateTime? @map("promised_date") // Data que o cliente prometeu pagar

  // ===== OBSERVAÇÕES =====
  notes           String?

  // ===== CONTROLE =====
  collectorId     String    @map("collector_id") // Quem fez a cobrança

  // ===== RELACIONAMENTOS =====
  loan            Loan      @relation(fields: [loanId], references: [id])
  customer        Customer  @relation(fields: [customerId], references: [id])
  collector       User      @relation(fields: [collectorId], references: [id], name: "CollectionCollector")

  @@map("collection_history")
  @@index([loanId])
  @@index([customerId])
  @@index([contactDate])
}

// ============================================================================
// 8. ATUALIZAÇÃO DO MODELO User (ADICIONAR RELACIONAMENTOS)
// ============================================================================

model User {
  id                  String               @id @default(uuid())
  authId              String?              @unique @map("auth_id")
  name                String
  email               String               @unique
  password            String
  role                String               @default("CLIENT") // CLIENT, ADMIN, COLLECTOR, PARTNER
  phone               String?
  address             String?
  city                String?
  neighborhood        String?
  avatarUrl           String?              @map("avatar_url")
  referralCode        String?              @unique @map("referral_code")
  createdAt           DateTime             @default(now()) @map("created_at")
  isPartner           Boolean              @default(false) @map("is_partner")
  partnerScore        Float?               @map("partner_score")
  hasCourseAccess     Boolean              @default(false) @map("has_course_access")

  // ===== RELACIONAMENTOS EXISTENTES =====
  customers           Customer[]           @relation("CustomerUser")
  loanRequests        LoanRequest[]        @relation("LoanRequestUser")
  partnerCustomers    Customer[]           @relation("CustomerPartner")
  partnerLoanRequests LoanRequest[]        @relation("LoanRequestPartner")
  approvedLoanRequests LoanRequest[]       @relation("LoanRequestApprovedBy")
  partnerCommissions  PartnerCommission[]  @relation("PartnerCommissionPartner")
  partnerBonuses      PartnerBonus[]       @relation("PartnerBonusPartner")
  partnerInvites      PartnerInvite[]      @relation("PartnerInvitePartner")
  pushSubscriptions   PushSubscription[]
  riskEvents          RiskEvent[]
  securityBlocks      SecurityBlock[]
  trustedDevices      TrustedDevice[]
  webauthnCredentials WebAuthnCredential[]
  userProgress        UserProgress[]
  trackflowQueries    TrackFlowQuery[]

  // ===== NOVOS RELACIONAMENTOS =====
  assignedCustomers   Customer[]           @relation("CustomerCollector") // Clientes atribuídos ao cobrador
  releasedLoans       Loan[]               @relation("LoanReleasedBy") // Empréstimos liberados
  registeredPayments  Payment[]            @relation("PaymentRegisteredBy") // Pagamentos registrados
  createdAgreements   Agreement[]          @relation("AgreementCreatedBy") // Acordos criados
  collectionActions   CollectionHistory[]  @relation("CollectionCollector") // Ações de cobrança

  @@map("users")
}

// ============================================================================
