generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AiChatHistory {
  id        String   @id @default(uuid())
  phone     String
  role      String
  content   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ai_chat_history")
}

model AiChatbotConfig {
  id                 String   @id @default(uuid())
  enabled            Boolean  @default(false)
  provider           String   @default("gemini")
  apiKey             String   @default("") @map("api_key")
  geminiApiKey       String   @default("") @map("gemini_api_key")
  perplexityApiKey   String   @default("") @map("perplexity_api_key")
  openaiApiKey       String   @default("") @map("openai_api_key")
  openrouterApiKey   String   @default("") @map("openrouter_api_key")
  nvidiaApiKey       String   @default("") @map("nvidia_api_key")
  zaiApiKey          String   @default("") @map("zai_api_key")
  anthropicApiKey    String   @default("") @map("anthropic_api_key")
  groqApiKey         String   @default("") @map("groq_api_key")
  grokApiKey         String   @default("") @map("grok_api_key")
  systemPrompt       String   @default("") @map("system_prompt")
  welcomeMessage     String   @default("") @map("welcome_message")
  fallbackMessage    String   @default("") @map("fallback_message")
  autoReplyEnabled   Boolean  @default(true) @map("auto_reply_enabled")
  workingHoursOnly   Boolean  @default(false) @map("working_hours_only")
  workingHoursStart  String   @default("08:00") @map("working_hours_start")
  workingHoursEnd    String   @default("18:00") @map("working_hours_end")
  maxMessagesPerChat Int      @default(50) @map("max_messages_per_chat")
  transferKeywords   String[] @default(["atendente", "humano", "pessoa"]) @map("transfer_keywords")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("ai_chatbot_config")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  userName  String   @map("user_name")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   String?
  ipAddress String?  @map("ip_address")
  timestamp DateTime @default(now())

  @@map("audit_logs")
}

model Blacklist {
  id      String   @id @default(uuid())
  cpf     String   @unique
  name    String
  reason  String
  addedBy String   @map("added_by")
  active  Boolean  @default(true)
  addedAt DateTime @default(now()) @map("added_at")

  @@map("blacklist")
}

model BrandSettings {
  id              String   @id @default(uuid())
  systemName      String   @map("system_name")
  logoUrl         String?  @map("logo_url")
  primaryColor    String   @default("#FF0000") @map("primary_color")
  secondaryColor  String   @default("#D4AF37") @map("secondary_color")
  backgroundColor String   @default("#000000") @map("background_color")
  companyName     String   @default("") @map("company_name")
  cnpj            String   @default("")
  address         String   @default("")
  phone           String   @default("")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("brand_settings")
}

model Campaign {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String?  @map("image_url")
  videoUrl    String?  @map("video_url")
  link        String?
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  frequency   String   @default("ONCE")
  active      Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("campaigns")
}

model CollectionRule {
  id              String   @id @default(uuid())
  daysOffset      Int      @map("days_offset")
  type            String
  messageTemplate String   @map("message_template")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("collection_rules")
}

model ContractSignature {
  id            String   @id @default(uuid())
  loanRequestId String   @map("loan_request_id")
  signatureUrl  String   @map("signature_url")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  signedAt      DateTime @default(now()) @map("signed_at")

  @@map("contract_signatures")
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discount      Float
  description   String
  imageUrl      String?   @map("image_url")
  partnerName   String?   @map("partner_name")
  partnerLogo   String?   @map("partner_logo")
  usageLimit    Int       @default(100) @map("usage_limit")
  usageCount    Int       @default(0) @map("usage_count")
  customerId    String?   @map("customer_id")
  customerEmail String?   @map("customer_email")
  expiresAt     DateTime  @map("expires_at")
  active        Boolean   @default(true)
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  customer      Customer? @relation(fields: [customerId], references: [id])

  @@map("coupons")
}

model Customer {
  id                    String         @id @default(uuid())
  userId                String?        @map("user_id")
  name                  String
  cpf                   String         @unique
  rg                    String?
  email                 String
  phone                 String
  status                String         @default("ACTIVE")
  internalScore         Int            @default(0) @map("internal_score")
  totalDebt             Float          @default(0) @map("total_debt")
  activeLoansCount      Int            @default(0) @map("active_loans_count")
  address               String?
  neighborhood          String?
  city                  String?
  state                 String?
  zipCode               String?        @map("zip_code")
  latitude              Float?
  longitude             Float?
  locationUpdatedAt     DateTime?      @map("location_updated_at")
  deviceInfo            String?        @map("device_info")
  lastIp                String?        @map("last_ip")
  monthlyIncome         Float?         @map("monthly_income")
  preApprovedAmount     Float?         @map("pre_approved_amount")
  preApprovedAt         DateTime?      @map("pre_approved_at")
  instagram             String?
  source                String?        @default("MANUAL")
  profilePic            String?        @map("profile_pic")
  birthDate             String?        @map("birth_date")
  monthlyInterestRate   Float?         @map("monthly_interest_rate")
  lateFixedFee          Float?         @map("late_fixed_fee")
  lateInterestDaily     Float?         @map("late_interest_daily")
  lateInterestMonthly   Float?         @map("late_interest_monthly")
  installmentOffer      Json?          @map("installment_offer")
  referralCode          String?        @unique @map("referral_code")
  referralPoints        Int            @default(0) @map("referral_points")
  joinedAt              DateTime       @default(now()) @map("joined_at")
  partnerId             String?        @map("partner_id")
  isPartnerCustomer     Boolean        @default(false) @map("is_partner_customer")
  partnerCommissionRate Float?         @map("partner_commission_rate")
  contractTermsAccepted Boolean        @default(false) @map("contract_terms_accepted")
  source_detail         String?
  coupons               Coupon[]
  partner               User?          @relation("CustomerPartner", fields: [partnerId], references: [id])
  user                  User?          @relation("CustomerUser", fields: [userId], references: [id])
  loanRequests          LoanRequest[]  @relation("LoanRequestCustomer")
  loans                 Loan[]
  notifications         Notification[]
  referralsReceived     Referral[]     @relation("ReferredCustomer")
  referralsGiven        Referral[]     @relation("ReferrerCustomer")

  @@index([source], map: "idx_customers_source")
  @@map("customers")
}

model GoalsSettings {
  id                      String   @id @default(uuid())
  monthlyLoanGoal         Float    @default(0) @map("monthly_loan_goal")
  monthlyClientGoal       Int      @default(0) @map("monthly_client_goal")
  monthlyApprovalRateGoal Float    @default(0) @map("monthly_approval_rate_goal")
  projections             Json?
  expectedGrowthRate      Float    @default(0) @map("expected_growth_rate")
  goalPeriod              String   @default("") @map("goal_period")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("goals_settings")
}

model Installment {
  id                String    @id @default(uuid())
  loanId            String    @map("loan_id")
  dueDate           DateTime  @map("due_date")
  amount            Float
  status            String    @default("OPEN")
  pixCode           String?   @map("pix_code")
  proofUrl          String?   @map("proof_url")
  paidAt            DateTime? @map("paid_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  lateFeeAmount     Float     @default(0) @map("late_fee_amount")
  fineAccumulated   Float     @default(0) @map("fine_accumulated")
  daysOverdue       Int       @default(0) @map("days_overdue")
  isInterestPayment Boolean   @default(false) @map("is_interest_payment")
  loan              Loan      @relation(fields: [loanId], references: [id])

  @@map("installments")
}

model LoanPackage {
  id              String   @id @default(uuid())
  name            String
  minValue        Float    @map("min_value")
  maxValue        Float    @map("max_value")
  minInstallments Int      @map("min_installments")
  maxInstallments Int      @map("max_installments")
  interestRate    Float    @map("interest_rate")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("loan_packages")
}

model LoanRequest {
  id                         String              @id @default(uuid())
  customerId                 String?             @map("customer_id")
  userId                     String?             @map("user_id")
  clientName                 String              @map("client_name")
  cpf                        String
  email                      String
  phone                      String
  preferredContactTime       String?             @map("preferred_contact_time")
  amount                     Float               @default(0)
  installments               Int                 @default(1)
  status                     String              @default("PENDING")
  profileType                String?             @map("profile_type")
  fatherPhone                String?             @map("father_phone")
  motherPhone                String?             @map("mother_phone")
  spousePhone                String?             @map("spouse_phone")
  fatherPhoneRelationship    String?             @map("father_phone_relationship")
  motherPhoneRelationship    String?             @map("mother_phone_relationship")
  spousePhoneRelationship    String?             @map("spouse_phone_relationship")
  address                    String?
  neighborhood               String?
  city                       String?
  state                      String?
  zipCode                    String?             @map("zip_code")
  birthDate                  String?             @map("birth_date")
  preferredDueDay            Int?                @map("preferred_due_day")
  instagram                  String?
  monthlyIncome              Float?              @map("monthly_income")
  selfieUrl                  String?             @map("selfie_url")
  idCardUrl                  String?             @map("id_card_url")
  idCardBackUrl              String?             @map("id_card_back_url")
  proofOfAddressUrl          String?             @map("proof_of_address_url")
  proofIncomeUrl             String?             @map("proof_income_url")
  vehicleUrl                 String?             @map("vehicle_url")
  videoSelfieUrl             String?             @map("video_selfie_url")
  videoHouseUrl              String?             @map("video_house_url")
  videoVehicleUrl            String?             @map("video_vehicle_url")
  signatureUrl               String?             @map("signature_url")
  workCardUrl                String?             @map("work_card_url")
  companyAddress             Json?               @map("company_address")
  companyProfession          String?             @map("company_profession")
  companyWorkSince           String?             @map("company_work_since")
  companyIncome              Float?              @map("company_income")
  companyPaymentDay          Int?                @map("company_payment_day")
  companyName                String?             @map("company_name")
  supplementalDescription    String?             @map("supplemental_description")
  supplementalDocUrl         String?             @map("supplemental_doc_url")
  supplementalRequestedAt    DateTime?           @map("supplemental_requested_at")
  supplementalUploadedAt     DateTime?           @map("supplemental_uploaded_at")
  latitude                   Float?
  longitude                  Float?
  accuracy                   Float?
  contractAccepted           Boolean             @default(false) @map("contract_accepted")
  contractTermsAccepted      Boolean             @default(false) @map("contract_terms_accepted")
  declarationAccepted        Boolean             @default(false) @map("declaration_accepted")
  bankName                   String?             @map("bank_name")
  bankAgency                 String?             @map("bank_agency")
  bankAccount                String?             @map("bank_account")
  bankAccountType            String?             @map("bank_account_type")
  pixKey                     String?             @map("pix_key")
  pixKeyType                 String?             @map("pix_key_type")
  createdAt                  DateTime            @default(now()) @map("created_at")
  updatedAt                  DateTime            @updatedAt @map("updated_at")
  contractPdfUrl             String?             @map("contract_pdf_url")
  referralCode               String?             @map("referral_code")
  partnerId                  String?             @map("partner_id")
  isPartnerReferral          Boolean             @default(false) @map("is_partner_referral")
  partnerCommissionRate      Float?              @map("partner_commission_rate")
  investmentTier             String?             @map("investment_tier")
  payoutMode                 String?             @map("payout_mode")
  monthlyRate                Float?              @map("monthly_rate")
  contractMonths             Int?                @map("contract_months")
  autoRenew                  Boolean             @default(true) @map("auto_renew")
  withdrawalNoticeMonths     Int?                @map("withdrawal_notice_months")
  accountHolderName          String?             @map("account_holder_name")
  isService                  Boolean             @default(false) @map("is_service")
  isInvestment               Boolean             @default(false) @map("is_investment")
  isLoan                     Boolean             @default(true) @map("is_loan")
  collateralItems            Json?               @map("collateral_items")
  approvedAmount             Float?              @map("approved_amount")
  approvedAt                 DateTime?           @map("approved_at")
  approvedById               String?             @map("approved_by_id")
  counterOfferAccepted       Boolean             @default(false) @map("counter_offer_accepted")
  counterOfferAcceptedAt     DateTime?           @map("counter_offer_accepted_at")
  requestedAmount            Float?              @map("requested_amount")
  reference1Name             String?             @map("reference1_name")
  reference1Phone            String?             @map("reference1_phone")
  reference2Name             String?             @map("reference2_name")
  reference2Phone            String?             @map("reference2_phone")
  has_more_than_3_months_clt Boolean?
  clt_auto_rejected          Boolean             @default(false)
  asset_description          String?
  asset_value                Float?
  asset_proof_url            String?
  commerce_terms_accepted    Boolean             @default(false)
  geofence_city              String?
  geofence_state             String?             @db.VarChar(5)
  geofence_blocked           Boolean             @default(false)
  billingType                String              @default("MONTHLY") @map("billing_type")
  approvedBy                 User?               @relation("LoanRequestApprovedBy", fields: [approvedById], references: [id])
  customer                   Customer?           @relation("LoanRequestCustomer", fields: [customerId], references: [id])
  partner                    User?               @relation("LoanRequestPartner", fields: [partnerId], references: [id])
  user                       User?               @relation("LoanRequestUser", fields: [userId], references: [id])
  loan                       Loan?
  notifications              Notification[]
  partnerCommissions         PartnerCommission[] @relation("PartnerCommissionLoanRequest")

  @@index([reference1Phone, reference2Phone], map: "idx_loan_requests_references")
  @@map("loan_requests")
}

model Loan {
  id                      String        @id @default(uuid())
  customerId              String        @map("customer_id")
  requestId               String        @unique @map("request_id")
  amount                  Float
  installmentsCount       Int           @map("installments_count")
  remainingAmount         Float         @map("remaining_amount")
  status                  String        @default("ACTIVE")
  startDate               DateTime      @map("start_date")
  createdAt               DateTime      @default(now()) @map("created_at")
  nivelOuroUtilizado      Boolean       @default(false) @map("nivel_ouro_utilizado")
  dataAtivacaoNivelOuro   DateTime?     @map("data_ativacao_nivel_ouro")
  isService               Boolean       @default(false) @map("is_service")
  isInvestment            Boolean       @default(false) @map("is_investment")
  isLoan                  Boolean       @default(true) @map("is_loan")
  updatedAt               DateTime      @default(now()) @updatedAt @map("updated_at")
  principalAmount         Float         @default(0) @map("principal_amount")
  dailyInstallmentAmount  Float?        @map("daily_installment_amount")
  totalInstallments       Int           @default(1) @map("total_installments")
  firstPaymentDate        DateTime?     @map("first_payment_date")
  pixReceiptUrl           String?       @map("pix_receipt_url")
  interestRate            Float?        @map("interest_rate")
  paymentFrequency        String        @default("MONTHLY") @map("payment_frequency")
  dueDay                  Int?          @map("due_day")
  daysOverdue             Int           @default(0) @map("days_overdue")
  lastPaymentDate         DateTime?     @map("last_payment_date")
  nextPaymentDate         DateTime?     @map("next_payment_date")
  lastCollectionMessageAt DateTime?     @map("last_collection_message_at") // Trava de idempotência diária da régua de cobrança
  adminNotes              String?       @map("admin_notes")
  source                  String?       @default("MANUAL")
  billing_type            String        @default("MONTHLY") @db.VarChar(20)
  installments            Installment[]
  customer                Customer      @relation(fields: [customerId], references: [id])
  loanRequest             LoanRequest   @relation(fields: [requestId], references: [id])

  @@index([status])
  @@index([customerId])
  @@index([nextPaymentDate])
  @@map("loans")
}

model MessageTemplate {
  id           String   @id @default(uuid())
  name         String
  category     String
  triggerEvent String?  @map("trigger_event")
  channel      String?
  subject      String?
  content      String
  variables    String[]
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([triggerEvent])
  @@index([isActive])
  @@index([category])
  @@map("message_templates")
}

model NotificationLog {
  id           String   @id @default(uuid())
  type         String
  recipient    String
  subject      String?
  content      String?
  status       String   @default("SENT")
  errorMessage String?  @map("error_message")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("notification_logs")
}

model Notification {
  id            String       @id @default(uuid())
  customerEmail String?      @map("customer_email")
  title         String
  message       String
  type          String       @default("INFO")
  createdAt     DateTime     @default(now()) @map("created_at")
  customerId    String?      @map("customer_id")
  isRead        Boolean      @default(false) @map("is_read")
  requestId     String?      @map("request_id")
  customer      Customer?    @relation(fields: [customerId], references: [id])
  loanRequest   LoanRequest? @relation(fields: [requestId], references: [id], onUpdate: NoAction)

  @@map("notifications")
}

model OtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  type      String   @default("EMAIL_VERIFY")
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_codes")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("push_subscriptions")
}

model RiskEvent {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  eventType String   @map("event_type")
  riskLevel String?  @map("risk_level")
  details   Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@map("risk_events")
}

model ScheduledStatus {
  id                 String    @id @default(uuid())
  title              String?
  content            String?
  mediaType          String?   @map("media_type")
  mediaUrl           String?   @map("media_url")
  imageUrl           String?   @map("image_url")
  caption            String?
  aiGeneratedCaption Boolean   @default(false) @map("ai_generated_caption")
  recurrence         String    @default("ONCE")
  selectedDays       String[]  @map("selected_days")
  postsPerDay        Int       @default(1) @map("posts_per_day")
  totalDays          Int       @default(1) @map("total_days")
  startDate          DateTime  @map("start_date")
  endDate            DateTime? @map("end_date")
  postTimes          String[]  @map("post_times")
  status             String    @default("SCHEDULED")
  nextPostAt         DateTime? @map("next_post_at")
  lastPostedAt       DateTime? @map("last_posted_at")
  postsCount         Int       @default(0) @map("posts_count")
  errorMessage       String?   @map("error_message")
  scheduledAt        DateTime  @default(now()) @map("scheduled_at")
  postedAt           DateTime? @map("posted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  createdBy          String?   @map("created_by")

  @@map("scheduled_status")
}

model SecurityAlert {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  userName    String   @map("user_name")
  userEmail   String   @map("user_email")
  alertType   String   @map("alert_type")
  severity    String
  title       String
  description String
  deviceInfo  Json?    @map("device_info")
  ipAddress   String?  @map("ip_address")
  location    Json?
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("security_alerts")
}

model SecurityBlock {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  blockType         String    @map("block_type")
  blockReason       String    @map("block_reason")
  deviceFingerprint String?   @map("device_fingerprint")
  ipAddress         String?   @map("ip_address")
  deviceInfo        Json?     @map("device_info")
  isResolved        Boolean   @default(false) @map("is_resolved")
  resolvedAt        DateTime? @map("resolved_at")
  resolvedBy        String?   @map("resolved_by")
  resolutionNotes   String?   @map("resolution_notes")
  expiresAt         DateTime? @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  user              User      @relation(fields: [userId], references: [id])

  @@map("security_blocks")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model TemporaryLink {
  id        String   @id @default(uuid())
  token     String   @unique
  type      String
  userId    String?  @map("user_id")
  email     String?
  metadata  Json?
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("temporary_links")
}

model Transaction {
  id          String   @id @default(uuid())
  type        String
  description String
  amount      Float
  category    String
  date        DateTime
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("transactions")
}

model TrustedDevice {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  deviceFingerprint String   @map("device_fingerprint")
  deviceName        String   @map("device_name")
  deviceModel       String?  @map("device_model")
  platform          String?
  browser           String?
  screenResolution  String?  @map("screen_resolution")
  lastIp            String?  @map("last_ip")
  lastLocationLat   Float?   @map("last_location_lat")
  lastLocationLng   Float?   @map("last_location_lng")
  isVerified        Boolean  @default(false) @map("is_verified")
  isPrimary         Boolean  @default(false) @map("is_primary")
  trustScore        Int      @default(0) @map("trust_score")
  loginCount        Int      @default(0) @map("login_count")
  firstSeenAt       DateTime @default(now()) @map("first_seen_at")
  lastSeenAt        DateTime @default(now()) @map("last_seen_at")
  user              User     @relation(fields: [userId], references: [id])

  @@map("trusted_devices")
}

model User {
  id                   String               @id @default(uuid())
  authId               String?              @unique @map("auth_id")
  name                 String
  email                String               @unique
  password             String
  role                 String               @default("CLIENT")
  phone                String?
  address              String?
  city                 String?
  neighborhood         String?
  avatarUrl            String?              @map("avatar_url")
  referralCode         String?              @unique @map("referral_code")
  createdAt            DateTime             @default(now()) @map("created_at")
  isPartner            Boolean              @default(false) @map("is_partner")
  partnerScore         Float?               @map("partner_score")
  hasCourseAccess      Boolean              @default(false) @map("has_course_access")
  commentRatings       CommentRating[]
  partnerCustomers     Customer[]           @relation("CustomerPartner")
  customers            Customer[]           @relation("CustomerUser")
  lessonComments       LessonComment[]
  approvedLoanRequests LoanRequest[]        @relation("LoanRequestApprovedBy")
  partnerLoanRequests  LoanRequest[]        @relation("LoanRequestPartner")
  loanRequests         LoanRequest[]        @relation("LoanRequestUser")
  partnerBonuses       PartnerBonus[]       @relation("PartnerBonusPartner")
  partnerCommissions   PartnerCommission[]  @relation("PartnerCommissionPartner")
  partnerInvites       PartnerInvite[]      @relation("PartnerInvitePartner")
  pushSubscriptions    PushSubscription[]
  quizResponses        QuizResponse[]
  riskEvents           RiskEvent[]
  securityBlocks       SecurityBlock[]
  trackflowQueries     TrackFlowQuery[]
  trustedDevices       TrustedDevice[]
  userProgress         UserProgress[]
  webauthnCredentials  WebAuthnCredential[]

  @@map("users")
}

model Course {
  id          String   @id @default(uuid())
  title       String
  description String?
  coverUrl    String?  @map("cover_url")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  modules     Module[]

  @@map("courses")
}

model Module {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  lessons     Lesson[]
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([order])
  @@map("modules")
}

model Lesson {
  id              String         @id @default(uuid())
  moduleId        String         @map("module_id")
  title           String
  description     String?
  videoUrl        String?        @map("video_url")
  materialUrl     String?        @map("material_url")
  order           Int            @default(0)
  duration        Int?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  descriptionHtml String?        @map("description_html")
  attachments     Json?          @default("[]")
  module          Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress        UserProgress[]

  @@index([moduleId])
  @@index([order])
  @@index([attachments], map: "idx_lessons_attachments", type: Gin)
  @@map("lessons")
}

model UserProgress {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  lessonId    String    @map("lesson_id")
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("user_progress")
}

model WebAuthnCredential {
  id                String    @id @default(uuid())
