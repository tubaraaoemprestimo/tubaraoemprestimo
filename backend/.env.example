# ============================================
# Tubarão Backend - Variáveis de Ambiente
# ============================================

# Database (PostgreSQL na Oracle Cloud)
DATABASE_URL="postgresql://tubarao:SUA_SENHA_AQUI@SEU_IP_ORACLE:5432/tubarao_db"

# JWT Secrets
JWT_SECRET="trocar-por-chave-secreta-longa-e-aleatoria"
JWT_REFRESH_SECRET="trocar-por-outra-chave-secreta-diferente"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Domínio em produção
API_URL="https://api.tubaraoemprestimo.com.br"
FRONTEND_URL="https://www.tubaraoemprestimo.com.br"

# Email (para confirmação e reset de senha)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-app-password"
EMAIL_FROM="Tubarão Empréstimos <noreply@tubaraoemprestimo.com.br>"

# Evolution API (WhatsApp)
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="SUA_CHAVE_AQUI"
EVOLUTION_INSTANCE="tubarao"

# Google Gemini AI
GEMINI_API_KEY="SUA_CHAVE_GEMINI"

# API CPF/CNPJ
CPF_API_URL="https://api.cpfcnpj.com.br"
CPF_API_TOKEN="SEU_TOKEN_AQUI"

# Push Notifications (VAPID Keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@tubaraoemprestimo.com.br"

# Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760
