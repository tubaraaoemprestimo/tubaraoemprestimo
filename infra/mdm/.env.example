# Copie para .env (o bootstrap.sh faz isso). NUNCA versione o .env (chmod 600).
# Segredos vazios são gerados automaticamente pelo scripts/bootstrap.sh.

# Senha da API do NanoHUB (HTTP Basic, usuário "nanohub"). Mesmo valor vai no backend (NANOHUB_API_KEY).
NANOHUB_API_KEY=

# Challenge do SCEP. Vai dentro do perfil de inscrição: trate como segredo.
SCEP_CHALLENGE=

# Host público dedicado ao MDM (sem https://). Ex.: mdm.tubaraoemprestimo.com.br
MDM_PUBLIC_HOST=mdm.exemplo.com.br

# Token do webhook (query ?token=). Mesmo valor deve estar configurado no backend.
MDM_WEBHOOK_TOKEN=

# Opcional: URL base do webhook (sem ?token). Padrão: backend no host, porta 3001.
# MDM_WEBHOOK_URL=http://host.docker.internal:3001/api/admin/mdm/webhook

# Opcional: validade em dias do certificado de identidade do aparelho (SCEP).
# SCEP_CERT_VALID=365

# Preenchido por scripts/upload-pushcert.sh após enviar o certificado APNs.
PUSH_TOPIC=

# Opcional: diretório de backups (padrão /var/backups/tubarao-mdm).
# BACKUP_DIR=/var/backups/tubarao-mdm
